# LabelGuard Backend Environment Configuration

# Allowed CORS Origins (comma-separated list, e.g. http://localhost:3000)
CORS_ORIGINS=http://localhost:3000

# SQLite, uploads, evidence, and reports. Use a persistent mount when hosted.
LABELGUARD_DATA_DIR=data

# Prototype in-process upload throttle.
UPLOAD_RATE_LIMIT_PER_MINUTE=30

# Required, backend-only Gemini image reader. Never expose this key in
# NEXT_PUBLIC_* variables or commit a real value. There is no OCR fallback.
GEMINI_ENABLED=true
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.7-flash
# Model router: clear images use FAST, difficult images use QUALITY, and
# routeable provider/model failures move through the comma-separated fallbacks.
GEMINI_FAST_MODEL=gemini-3.7-flash
GEMINI_QUALITY_MODEL=gemini-3.1-pro-preview
GEMINI_FALLBACK_MODELS=gemini-3.6-flash,gemini-2.5-flash
GEMINI_TIMEOUT_SECONDS=45
# Provider-call protection is separate from the upload endpoint throttle.
GEMINI_RATE_LIMIT_PER_MINUTE=10
GEMINI_MAX_CONCURRENT_REQUESTS=2
GEMINI_MAX_ATTEMPTS_PER_MODEL=2
# Keep false for one Gemini request per inspection. When true, a second,
# non-visual call may explain the already-final deterministic result.
GEMINI_EXPLANATION_ENABLED=false
GEMINI_EXPLANATION_MODEL=gemini-3.7-flash
