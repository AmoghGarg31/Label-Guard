{
  "rule_id": "LMPC-DOM-001",
  "rule_version": "2.0",
  "active": true,
  "field": "date_of_manufacture",
  "source_citation": "Legal Metrology (Packaged Commodities) Rules, 2011, Rule 6(1)(d)",
  "description": "The applicable month and year declaration must be present in a recognizable date format; category-specific exceptions still require officer review.",
  "check_type": "presence_and_pattern",
  "pattern": "(?:(?:[0-3]?[0-9][./\\-\\s]+)?(?:[0-1]?[0-9]|Jan(?:uary)?|Feb(?:ruary)?|Mar(?:ch)?|Apr(?:il)?|May|Jun(?:e)?|Jul(?:y)?|Aug(?:ust)?|Sep(?:tember)?|Oct(?:ober)?|Nov(?:ember)?|Dec(?:ember)?)[./\\-\\s]+(?:[12][0-9]{3}|[0-9]{2})|(?:[12][0-9]{3}[./\\-\\s]+[0-1]?[0-9]))",
  "severity_if_fail": "high",
  "confidence_floor": 0.55,
  "on_field_missing": "UNCERTAIN"
}
