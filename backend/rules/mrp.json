{
  "rule_id": "LMPC-MRP-001",
  "rule_version": "2.0",
  "active": true,
  "field": "mrp",
  "source_citation": "Legal Metrology (Packaged Commodities) Rules, 2011, Rule 6(1)(e)",
  "description": "Maximum retail price must be present in a recognizable Indian-currency format.",
  "check_type": "presence_and_pattern",
  "pattern": "^(?:₹|Rs\\.?|INR)\\s*[0-9][0-9,]*(?:\\.[0-9]{1,2})?$",
  "severity_if_fail": "high",
  "confidence_floor": 0.55,
  "on_field_missing": "UNCERTAIN"
}
